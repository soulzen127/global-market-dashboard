{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["server.js", "storage.js", "market-data.js", "index.html", "login.html", "login.js", "login.css", "app.js", "styles.css", "strategy.js", "strategy.css", "portfolio.js", "responsive.css", "responsive.js"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
